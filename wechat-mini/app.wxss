page {
  min-height: 100%;
  background: #f4f6fa;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

button {
  border-radius: 16rpx;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #fff;
  border: 1rpx solid #e5eaf1;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2937;
}

.sub {
  font-size: 22rpx;
  color: #94a3b8;
}

.muted {
  color: #64748b;
  font-size: 24rpx;
}

.hint {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.7;
  margin-top: 12rpx;
}

.primary-btn {
  background: #1d4ed8;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 18rpx 0;
}

.primary-btn::after,
.ghost-btn::after {
  border: none;
}

.ghost-btn {
  background: #eef2f7;
  color: #1d4ed8;
  font-size: 26rpx;
  padding: 14rpx 0;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: #eef2f7;
  color: #475569;
}

.tag.cyc {
  background: #e6f5f1;
  color: #0f766e;
}

.tag.blue {
  background: #eaf0ff;
  color: #1d4ed8;
}

.warn-text {
  color: #b45309;
}
