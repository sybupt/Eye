.series-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.series-tab {
  font-size: 24rpx;
  color: #475569;
  background: #eef2f7;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
}

.series-tab.on {
  background: #1d4ed8;
  color: #fff;
}

.chart-head {
  display: flex;
  gap: 28rpx;
  margin-bottom: 16rpx;
}

.legend {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.line {
  width: 40rpx;
  height: 4rpx;
}

.line.od {
  background: #2563eb;
}

.line.os {
  border-top: 4rpx dashed #ea580c;
}

.chart {
  position: relative;
  width: 690rpx;
  height: 340rpx;
}

.grid-line {
  position: absolute;
  height: 1rpx;
  background: #eef1f5;
}

.axis-y {
  position: absolute;
  left: 0;
  font-size: 20rpx;
  color: #b0bccb;
}

.axis-y.max { top: 10rpx; }
.axis-y.min { bottom: 44rpx; }

.seg {
  position: absolute;
  height: 4rpx;
  transform-origin: 0 50%;
  border-radius: 2rpx;
}

.seg.od {
  background: #2563eb;
}

.seg.os {
  background: repeating-linear-gradient(90deg, #ea580c 0, #ea580c 12rpx, transparent 12rpx, transparent 20rpx);
}

.dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dot.od {
  background: #2563eb;
}

.dot.os {
  background: #fff;
  border: 3rpx solid #ea580c;
}

.axis-x {
  position: absolute;
  bottom: 6rpx;
  width: 68rpx;
  text-align: center;
  font-size: 18rpx;
  color: #b0bccb;
}

.chart-unit {
  text-align: center;
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
}
