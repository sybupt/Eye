.metric-head {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #eef1f6;
}

.mh-name {
  flex: 2;
  font-size: 22rpx;
  color: #94a3b8;
}

.mh-eye {
  flex: 1;
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
}

.metric-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f3f7;
}

.mr-name {
  flex: 2;
  font-size: 26rpx;
  color: #334155;
}

.mr-val {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.mr-val.od { color: #1d4ed8; }
.mr-val.os { color: #94a3b8; }

.raw-row {
  font-size: 24rpx;
  color: #475569;
  padding: 10rpx 16rpx;
  background: #f6f8fb;
  border-radius: 8rpx;
  margin-top: 10rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.batch-note {
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
  margin-top: 12rpx;
  display: inline-block;
}

.report-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f3f7;
}

.report-name {
  flex: 1;
  font-size: 26rpx;
  color: #334155;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.report-btn {
  margin-top: 20rpx;
}

.export-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 1200rpx;
}

.action-row button {
  flex: 1;
  font-size: 26rpx;
  padding: 16rpx 0;
}

.tag {
  font-size: 20rpx;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
}

.tag.cyc { color: #b45309; background: #fef3c7; }

.primary-btn {
  background: #2563eb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 16rpx 0;
}

.ghost-btn {
  background: #fff;
  color: #2563eb;
  border: 1rpx solid #2563eb;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 16rpx 0;
}

.foot {
  text-align: center;
  font-size: 20rpx;
  color: #b0bccb;
  margin-top: 30rpx;
}
