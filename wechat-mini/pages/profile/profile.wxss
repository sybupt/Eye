.profile-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: #eaf0ff;
  color: #1d4ed8;
  font-size: 36rpx;
  font-weight: 500;
}

.profile-main {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  flex: 1;
}

.nickname {
  font-size: 32rpx;
  font-weight: 500;
}

.intro {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.login-btn {
  font-size: 24rpx;
  color: #1d4ed8;
  background: #eaf0ff;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
}

.mode-tag {
  font-size: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 20rpx;
  margin-top: 12rpx;
  display: inline-block;
}
.mode-tag.cloud { color: #0f766e; background: #e6f5f1; }
.mode-tag.demo { color: #b45309; background: #fef3c7; }

.profile-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f3f7;
}

.profile-item:last-child { border-bottom: none; }

.pi-tap {
  display: flex;
  align-items: center;
  flex: 1;
}

.del-btn {
  font-size: 22rpx;
  color: #dc2626;
  background: #fef2f2;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  margin-left: 12rpx;
}

.rebuild {
  font-size: 24rpx;
  color: #64748b;
  background: #f4f7fb;
  border-radius: 14rpx;
  text-align: center;
  padding: 16rpx;
  margin-top: 18rpx;
}

.avatar-sm {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: #eef2f7;
  color: #475569;
  font-size: 24rpx;
}

.pi-main {
  display: flex;
  flex-direction: column;
  margin-left: 18rpx;
  flex: 1;
}

.pi-name {
  font-size: 27rpx;
  color: #334155;
}

.arrow {
  color: #94a3b8;
  font-size: 36rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3f7;
}

.menu-item:last-child { border-bottom: none; }

.menu-text {
  font-size: 27rpx;
  color: #334155;
}

.menu-arrow {
  color: #94a3b8;
  font-size: 34rpx;
}

.foot {
  text-align: center;
  font-size: 20rpx;
  color: #b0bccb;
  margin-top: 30rpx;
}
