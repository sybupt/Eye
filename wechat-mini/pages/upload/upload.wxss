.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3f7;
}

.field:last-child { border-bottom: none; }

.field-label {
  font-size: 27rpx;
  color: #334155;
}

.field-value {
  font-size: 27rpx;
  color: #1d4ed8;
}

.switch-field { padding-top: 12rpx; }

.source-picker {
  font-size: 27rpx;
  color: #1d4ed8;
  background: #eaf0ff;
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  margin: 14rpx 0 4rpx;
}

.pdf-thumb {
  width: 100%;
  height: 100%;
  background: #fef2f2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 10rpx;
}

.pdf-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #dc2626;
  background: #fff;
  border: 1rpx solid #fecaca;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.pdf-name {
  font-size: 18rpx;
  color: #b45309;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 16rpx 0;
}

.photo, .photo-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.photo image {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(15, 23, 42, .6);
  color: #fff;
  font-size: 28rpx;
}

.photo-add {
  border: 2rpx dashed #b9c7e0;
  background: #fafcff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus {
  font-size: 52rpx;
  color: #1d4ed8;
  line-height: 1;
}

.preview-title {
  font-size: 25rpx;
  font-weight: 500;
  color: #334155;
  align-self: flex-start;
  margin-top: 18rpx;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f3f7;
}

.pv-name { font-size: 23rpx; color: #64748b; }
.pv-text { font-size: 23rpx; color: #1f2937; font-variant-numeric: tabular-nums; }

.progress {
  height: 12rpx;
  background: #e8edf5;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 18rpx 0 8rpx;
}

.progress-bar {
  height: 100%;
  background: #1d4ed8;
  transition: width .3s;
}

.done-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 8rpx;
}

.done-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 50%;
  background: #e8f6ef;
  color: #047857;
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.done-card button {
  width: 100%;
  margin-top: 16rpx;
}

.submit-btn {
  margin-top: 8rpx;
}

.sub.ok { color: #0f766e; }
.demo-banner {
  font-size: 22rpx;
  color: #b45309;
  background: #fef3c7;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin: 12rpx 0;
}
