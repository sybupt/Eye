      "abbr": ["NCT", "眼压", "IOP"],
      "category": "IOP",
      "value_type": "decimal",
      "unit": "mmHg",
      "side": "OD/OS",
      "reference": {"type": "fixed", "low": 10, "high": 21, "note": "适合大规模筛查;>21需结合角膜厚度与视野复查"},
      "pediatric_key": false,
      "source": "眼科检验报告解析"
