      "category": "BIO",
      "value_type": "decimal",
      "unit": "mm",
      "side": "OD/OS",
      "reference": {"type": "fixed", "range": "2.5~3.5", "note": "青光眼/闭角风险相关，<2.5mm需警惕"},
      "pediatric_key": false,
      "source": "生物测量常规"
    },
    {
      "code": "BIO_LT",
      "name": "晶状体厚度",
      "en": "Lens Thickness",
      "abbr": ["LT", "晶状体厚度"],
      "category": "BIO",
      "value_type": "decimal",
      "unit": "mm",
      "side": "OD/OS",
      "reference": {"type": "fixed", "range": "3.5~4.5", "note": "随年龄增厚，老视/白内障相关"},
      "pediatric_key": false,
      "source": "生物测量常规"
    },
    {
      "code": "BIO_WTW",
      "name": "白到白距离",
      "en": "White-to-White",
      "abbr": ["WTW", "白到白"],
      "category": "BIO",
      "value_type": "decimal",
      "unit": "mm",
      "side": "OD/OS",
      "reference": {"type": "fixed", "range": "10.5~12.5"},
      "pediatric_key": false,
      "source": "生物测量常规"
    },
    {
      "code": "BIO_ALCR",
      "name": "眼轴角膜曲率比",
      "en": "AL/CR Ratio",
      "abbr": ["AL/CR"],
      "category": "BIO",
      "value_type": "decimal",
      "unit": "比值",
