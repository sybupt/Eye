{
  "meta": {
    "name": "眼科/视觉系统检查指标字典",
    "version": "1.0.0",
    "date": "2026-11-18",
    "purpose": "个人医疗检查报告汇总系统(PHR)眼科模块 - 结构化入库的指标主数据",
    "disclaimer": "正常值为人群参考区间，不同设备/种族/个体差异较大；儿童指标须结合年龄判读；本字典用于数据归集与趋势展示，不作为诊断依据。",
    "sources": [
      "国家卫生健康委《近视防治指南(2024年版)》国卫办医政函〔2024〕168号",
      "教育部/国家卫健委/国家疾控局《关于防控儿童青少年高度近视的通知》(2026)",
      "中华医学会眼科学分会斜视弱视学组(视力下限界值)",
      "腾讯医典/人民卫生出版社《眼科学》第9版指标参考",
      "验光师之家/好大夫在线 双眼视功能主流正常值",
      "《中国青光眼指南(2020年)》OCT/视野相关"
    ]
  },
  "side_codes": {
    "OD": "右眼 (Right)",
    "OS": "左眼 (Left)",
    "OU": "双眼 (Both)"
  },
  "report_categories": [
    {
      "id": "VA",
      "name": "视力检查",
      "en": "Visual Acuity",
      "scene": "所有就诊/筛查的基础必查项；儿童视觉发育监测第一步",
      "indicators": ["VA_UCVA", "VA_BCVA", "VA_NEAR", "VA_PINHOLE"],
      "source_docs": ["视力检查报告", "体检报告", "视力筛查单", "病历"]
    },
    {
      "id": "REF",
      "name": "屈光/验光检查",
      "en": "Refraction",
      "scene": "判断近视/远视/散光；儿童须散瞳(睫状肌麻痹)验光为金标准",
      "indicators": ["REF_SPH", "REF_CYL", "REF_AXIS", "REF_SE", "REF_PD", "REF_CORRECT_VA"],
      "source_docs": ["电脑验光单", "医学验光单", "散瞳验光单", "配镜处方"]
    },
    {
      "id": "BIO",
      "name": "眼生物测量",
      "en": "Ocular Biometry",
      "scene": "儿童近视防控核心：眼轴+角膜曲率；也是白内障人工晶体计算依据",
      "indicators": ["BIO_AL", "BIO_K", "BIO_AST", "BIO_ACD", "BIO_LT", "BIO_WTW", "BIO_ALCR"],
      "source_docs": ["IOL Master报告", "Lenstar报告", "A超报告", "眼生物测量单"]
    },
    {
      "id": "IOP",
      "name": "眼压/青光眼筛查",
      "en": "Tonometry / Glaucoma",
      "scene": "青光眼风险筛查与随访；高度近视/糖尿病/老年重点",
      "indicators": ["IOP_NCT", "IOP_GOLDMANN", "IOP_CCT"],
      "source_docs": ["非接触眼压报告", "Goldmann眼压记录", "青光眼随访单"]
    },
    {
      "id": "OCT",
      "name": "OCT / 眼底影像",
      "en": "OCT / Fundus Imaging",
      "scene": "黄斑/视神经结构评估；糖尿病视网膜病变、AMD、青光眼随访",
      "indicators": ["OCT_CMT", "OCT_RNFL", "OCT_CD", "OCT_MACVOL", "FUNDUS_PHOTO"],
      "source_docs": ["OCT报告", "眼底照相报告", "眼底彩照"]
    },
    {
      "id": "VF",
      "name": "视野检查",
      "en": "Visual Field / Perimetry",
      "scene": "青光眼诊断与分期、视路病变评估",
      "indicators": ["VF_MD", "VF_PSD", "VF_VFI"],
      "source_docs": ["Humphrey视野报告", "视野计报告"]
    },
    {
      "id": "BV",
      "name": "双眼视/视功能检查",
      "en": "Binocular Vision",
      "scene": "视疲劳、集合不足、调节异常、斜弱视评估；近视防控辅助",
      "indicators": ["BV_NRA", "BV_PRA", "BV_BCC", "BV_ACA", "BV_AMP", "BV_FACILITY", "BV_NPC", "BV_PHORIA", "BV_FUSION", "BV_STEREO", "BV_COLOR"],
      "source_docs": ["视功能检查报告", "双眼视功能分析单", "综合验光仪记录"]
    },
    {
      "id": "DRY",
      "name": "干眼/眼表检查",
      "en": "Dry Eye / Ocular Surface",
      "scene": "干眼分型与随访；视频终端人群高发",
      "indicators": ["DRY_BUT", "DRY_SCHIRMER", "DRY_FLUO", "DRY_TMH", "DRY_LIPID"],
      "source_docs": ["干眼分析报告", "眼表综合分析报告", "泪膜检查单"]
    },
    {
      "id": "PED",
      "name": "儿童近视防控衍生指标",
      "en": "Pediatric Myopia Control (derived)",
      "scene": "由原始指标计算得到，是防控场景最重要的趋势指标",
      "indicators": ["PED_HYPEROPIA_RESERVE", "PED_AL_GROWTH", "PED_SE_PROGRESS", "PED_MYopia_STAGE"],
      "source_docs": ["系统自动计算"]
    }
  ],
  "indicators": [
    {
      "code": "VA_UCVA",
      "name": "裸眼远视力",
      "en": "Uncorrected Visual Acuity",
      "abbr": ["UCVA", "裸眼视力", "Vod", "Vos", "VA"],
      "category": "VA",
      "value_type": "decimal",
      "unit": "decimal(小数记录)",
      "unit_conversion": "小数=5分记录-4.7对应(0.8=4.9,1.0=5.0); logMAR=-log10(小数)",
      "side": "OD/OS",
      "reference": {
        "type": "age_band",
        "bands": [
          {"age": "3岁", "decimal_min": 0.5, "five_point_min": 4.7, "note": "3~5岁下限0.5(中华医学会斜视弱视学组)"},
          {"age": "4岁", "decimal_min": 0.6, "five_point_min": 4.8},
          {"age": "5岁", "decimal_min": 0.6, "five_point_min": 4.8, "note": "部分标准0.8~1.0"},
          {"age": "6岁及以上", "decimal_min": 0.7, "five_point_min": 4.85, "note": "指南下限0.7;多数可达1.0"},
          {"age": "成人", "decimal_min": 1.0, "five_point_min": 5.0}
        ],
        "direction": "higher_is_better"
      },
      "pediatric_key": true,
      "source": "近视防治指南(2024年版)/腾讯医典"
    },
    {
      "code": "VA_BCVA",
      "name": "矫正远视力",
      "en": "Best Corrected Visual Acuity",
      "abbr": ["BCVA", "矫正视力", "戴镜视力"],
      "category": "VA",
      "value_type": "decimal",
      "unit": "decimal(小数记录)",
      "side": "OD/OS",
      "reference": {"type": "fixed", "low": 1.0, "note": "成人应达1.0及以上;儿童低于同龄下限警惕弱视"},
      "pediatric_key": true,
      "source": "眼科学第9版"
    },
    {
      "code": "VA_NEAR",
      "name": "近视力",
      "en": "Near Visual Acuity",
      "abbr": ["近视力", "Jager"],
      "category": "VA",
      "value_type": "string",
      "unit": "小数/Jaeger",
      "side": "OD/OS",
      "reference": {"type": "fixed", "note": "33cm处检查;老视人群下降"},
      "pediatric_key": false,
      "source": "腾讯医典"
    },
    {
      "code": "VA_PINHOLE",
      "name": "针孔视力",
      "en": "Pinhole Visual Acuity",
      "abbr": ["针孔视力", "PH"],
      "category": "VA",
      "value_type": "decimal",
      "unit": "decimal",
      "side": "OD/OS",
      "reference": {"type": "fixed", "note": "加针孔后提升提示屈光不正为主因"},
      "pediatric_key": false,
      "source": "临床常规"
    },
    {
      "code": "REF_SPH",
      "name": "球镜度数",
      "en": "Sphere",
      "abbr": ["S", "SPH", "DS", "球镜"],
      "category": "REF",
      "value_type": "decimal",
      "unit": "D(屈光度)",
      "side": "OD/OS",
      "reference": {"type": "fixed", "note": "负号=近视 正号=远视;儿童新生儿生理性远视+2.50~+3.00D"},
      "pediatric_key": true,
      "source": "配镜/验光单术语标准"
    },
    {
      "code": "REF_CYL",
      "name": "柱镜度数(散光)",
      "en": "Cylinder",
      "abbr": ["C", "CYL", "DC", "柱镜", "散光"],
      "category": "REF",
      "value_type": "decimal",
      "unit": "D(屈光度)",
      "side": "OD/OS",
      "reference": {"type": "fixed", "note": "儿童散光>1.00D需关注;双眼散光相差>1.00D警惕弱视"},
      "pediatric_key": true,
      "source": "校筛解读/新华网"
    },
    {
      "code": "REF_AXIS",
      "name": "散光轴位",
      "en": "Axis",
      "abbr": ["A", "AXIS", "AXL", "轴位"],
      "category": "REF",
      "value_type": "integer",
      "unit": "度(1~180°)",
      "side": "OD/OS",
      "reference": {"type": "fixed", "min": 1, "max": 180, "note": "180°水平 90°垂直;无散光则无轴位"},
      "pediatric_key": false,
      "source": "验光单术语标准"
    },
    {
      "code": "REF_SE",
      "name": "等效球镜度",
      "en": "Spherical Equivalent",
      "abbr": ["SE", "SERSE", "等效球镜"],
      "category": "REF",
      "value_type": "decimal",
      "unit": "D(屈光度)",
      "formula": "SE = SPH + 0.5 × CYL",
      "side": "OD/OS",
      "reference": {
        "type": "age_band",
        "bands": [
          {"age": "新生儿", "value": "+2.50~+3.00", "note": "生理性远视"},
          {"age": "3~5岁", "value": "+2.00~+2.50"},
          {"age": "6岁", "value": "均值+1.38", "note": "低于年龄下限=远视储备不足"},
          {"age": "8~9岁", "value": "约+1.00~+1.25", "note": "下降最快期 年降约0.37D"},
          {"age": "12~15岁", "value": "-0.50~+0.50", "note": "正视化完成"}
        ],
        "direction": "age_dependent"
      },
      "pediatric_key": true,
      "source": "近视防治指南(2024年版)"
    },
    {
      "code": "REF_PD",
      "name": "瞳距",
      "en": "Pupillary Distance",
      "abbr": ["PD", "瞳距"],
      "category": "REF",
      "value_type": "decimal",
      "unit": "mm",
      "side": "OU",
      "reference": {"type": "fixed", "note": "成人约54~74mm;儿童较小;配镜定光学中心用"},
      "pediatric_key": false,
      "source": "验光单术语标准"
    },
    {
      "code": "REF_CORRECT_VA",
      "name": "矫正视力(验光单)",
      "en": "Corrected Visual Acuity",
      "abbr": ["VA"],
      "category": "REF",
      "value_type": "decimal",
      "unit": "decimal",
      "side": "OD/OS",
      "reference": {"type": "fixed", "note": "评估矫正效果"},
      "pediatric_key": true,
      "source": "验光单术语标准"
    },
    {
      "code": "BIO_AL",
      "name": "眼轴长度",
      "en": "Axial Length",
      "abbr": ["AL", "眼轴", "眼轴长度"],
      "category": "BIO",
      "value_type": "decimal",
      "unit": "mm",
      "precision": 2,
      "side": "OD/OS",
      "reference": {
        "type": "age_band",
        "bands": [
          {"age": "出生", "value": 16.0, "note": "约16mm"},
          {"age": "1岁", "value": 17.5},
          {"age": "3岁", "value": 21.0, "range": "20~22"},
          {"age": "6岁", "value": 22.5, "range": "22~23", "note": "指南:6岁平均约22.5mm"},
          {"age": "9~10岁", "value": 23.5, "range": "23~24"},
          {"age": "12岁", "value": 24.0, "note": "接近成人"},
          {"age": "15岁", "value": 23.4, "note": "指南:接近成人水平"},
          {"age": "成人", "value": 23.5, "range": "22.5~24.5", "note": ">26mm属高度近视期"}
        ],
        "direction": "age_dependent",
        "note": "眼轴不可逆增长，是近视进展最客观指标;不同设备测量值存在系统差异，随访尽量同设备"
      },
      "pediatric_key": true,
      "source": "近视防治指南(2024年版)"
    },
    {
      "code": "BIO_K",
      "name": "角膜曲率",
      "en": "Keratometry",
      "abbr": ["K", "K1", "K2", "Km", "平K", "陡K"],
      "category": "BIO",
      "value_type": "decimal",
      "unit": "D(屈光度)",
      "side": "OD/OS",
      "reference": {
        "type": "fixed",
        "low": 40,
        "high": 47,
        "mean": 43,
        "radius_mm": {"adult": 7.77, "child_3_15": 7.79},
        "note": "双眼差<1.0D;中央3mm>47.2D警惕圆锥角膜;<39D偏平坦"
      },
      "pediatric_key": true,
      "source": "腾讯医典-角膜曲率"
    },
    {
      "code": "BIO_AST",
      "name": "角膜散光",
      "en": "Corneal Astigmatism",
      "abbr": ["AST", "角膜散光", "CYL(K)"],
      "category": "BIO",
      "value_type": "decimal",
      "unit": "D(屈光度)",
