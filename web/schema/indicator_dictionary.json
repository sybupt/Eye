      "abbr": ["GAT", "Goldmann"],
      "category": "IOP",
      "value_type": "decimal",
      "unit": "mmHg",
      "side": "OD/OS",
      "reference": {"type": "fixed", "low": 10, "high": 21, "note": "诊断金标准;昼夜波动3~6mmHg"},
      "pediatric_key": false,
      "source": "眼科检验报告解析"
    },
    {
      "code": "IOP_CCT",
      "name": "中央角膜厚度",
